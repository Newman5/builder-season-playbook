---
title: Piece of Pie Hackathon
description: Official landing page for the current Builder Season.
layoutClass: event-landing
---

{% extends "base.njk" %}

{% set eventTitle = event.eventName or landing.hero.eventName %}
{% set seasonTitle = event.seasonName or landing.hero.seasonName %}
{% set communityName = event.communityName or landing.hero.communityName %}
{% set registrationUrl = event.registrationFormUrl or "#register" %}
{% set rewardCurrency = event.rewardCurrency or "ADA" %}
{% set totalRewards = event.totalParticipantRewards %}
{% set weeklyTags = event.weeklyUpdateHashtags | join(", ") %}

{% block title %}{{ eventTitle }}{% endblock %}

{% block content %}
<div class="pop-page">
  <section class="pop-hero" aria-labelledby="landing-title">
    <div class="pop-panel pop-hero-copy">
      <div class="pop-eyebrow">{{ landing.hero.eyebrow }}</div>
      <h2 id="landing-title">{{ landing.hero.title }}</h2>
      <p class="pop-lead">
        {{ eventTitle }} is a {{ event.builderUpdateDurationWeeks or landing.hero.duration }}-week, participation-driven builder season.
        {{ landing.hero.lead }}
      </p>
      <div class="pop-actions">
        <a class="pop-btn pop-btn-primary" href="#rules">Read the rules first</a>
        <a class="pop-btn pop-btn-secondary" href="#register">Go to registration</a>
        <a class="pop-btn pop-btn-quiet" href="{{ '/dashboard/' | withBase }}">View dashboard</a>
      </div>
    </div>

    <aside class="pop-panel pop-hero-side" aria-label="Season overview">
      <div class="pop-sticker">overview</div>
      <p>{{ landing.hero.sideCopy }}</p>
      <div class="mini-grid">
        {% for stat in landing.hero.stats %}
          <div class="mini">
            <strong>{{ stat.label }}</strong>
            {% if stat.value == "event_duration" %}
              {{ event.builderUpdateDurationWeeks or landing.hero.duration }} weeks
            {% elif stat.value == "enrollment" %}
              {{ event.enrollmentStart | readableDate }} to {{ event.enrollmentEnd | readableDate }}
            {% elif stat.value == "weekly_update" %}
              1 public update every week
            {% else %}
              {{ stat.value }}
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </aside>
  </section>

  <section id="overview" class="pop-section pop-panel">
    <div class="section-head">
      <div>
        <p class="pop-kicker">Overview</p>
        <h2 class="section-title">{{ landing.overview.title }}</h2>
        <p class="section-sub">{{ landing.overview.copy }}</p>
      </div>
      <div class="priority-pill">{{ seasonTitle }} by {{ communityName }}</div>
    </div>
    <div class="overview-grid">
      {% for item in landing.overview.cards %}
        <article class="rule">
          <div class="rule-num">{{ loop.index }}</div>
          <h3>{{ item.title }}</h3>
          <p>{{ item.copy }}</p>
        </article>
      {% endfor %}
    </div>
  </section>

  <section id="how-it-works" class="pop-section pop-panel workflow-section">
    <div class="section-head">
      <div>
        <p class="pop-kicker">How it works</p>
        <h2 class="section-title">{{ landing.howItWorks.title }}</h2>
        <p class="section-sub">{{ landing.howItWorks.copy }}</p>
      </div>
    </div>
    <div class="kanban-board" aria-label="Builder season workflow">
      {% for step in landing.howItWorks.steps %}
        <article class="kanban-card">
          <span>0{{ loop.index }}</span>
          <h3>{{ step.title }}</h3>
          <p>{{ step.copy }}</p>
        </article>
      {% endfor %}
    </div>
  </section>

  <section id="rewards" class="pop-section pop-panel pie-share-section">
    <div class="section-head">
      <div>
        <p class="pop-kicker">Rewards</p>
        <h2 class="section-title">{{ landing.rewards.title }}</h2>
        <p class="section-sub">{{ landing.rewards.copy }}</p>
      </div>
      <div class="priority-pill availability-pill">
        <strong>{% if totalRewards %}{{ totalRewards | numberWithCommas }} {{ rewardCurrency }}{% else %}Rewards{% endif %} available</strong>
        <span>{{ landing.rewards.pill }}</span>
      </div>
    </div>

    <div class="pie-share-overview">
      <aside class="pie-pool-card" aria-label="Reward pools">
        <div class="pie-chart" aria-hidden="true">
          <div class="pie-hole">
            <strong>{% if totalRewards %}{{ totalRewards | numberWithCommas }}{% else %}Pool{% endif %}</strong>
            <span>{{ rewardCurrency }}</span>
          </div>
        </div>
        <div class="pie-legend">
          {% for reward in landing.rewards.cards %}
            <div class="pie-legend-item">
              <span class="pie-dot pie-dot--{{ reward.key }}"></span>{{ reward.title }} - {{ event[reward.amountKey] | numberWithCommas }} {{ rewardCurrency }}
            </div>
          {% endfor %}
        </div>
      </aside>

      <div class="pie-share-grid">
        {% for reward in landing.rewards.cards %}
          <article class="pie-share-card">
            <h3>{{ reward.title }} - {{ event[reward.amountKey] | numberWithCommas }} {{ rewardCurrency }}</h3>
            <p>{{ reward.copy }}</p>
          </article>
        {% endfor %}
      </div>
    </div>
  </section>

  <section id="sponsors" class="pop-section pop-panel sponsor-panel" aria-labelledby="sponsor-title">
    <div class="sponsor-layout">
      <div class="sponsor-logo-card" aria-hidden="true">
        <span>{{ landing.sponsors.mark }}</span>
      </div>
      <div class="sponsor-content">
        <span class="sponsor-kicker">Sponsors</span>
        <h2 id="sponsor-title" class="sponsor-title">{{ landing.sponsors.title }}</h2>
        <p class="sponsor-copy">
          {% if event.sponsorNames.length %}
            {{ event.sponsorNames | join(", ") }} support this season's reward pools and builder-facing incentives.
          {% else %}
            {{ landing.sponsors.copy }}
          {% endif %}
        </p>
      </div>
    </div>
  </section>

  <section id="rules" class="pop-section pop-panel">
    <div class="section-head">
      <div>
        <p class="pop-kicker">Rules</p>
        <h2 class="section-title">{{ landing.rules.title }}</h2>
        <p class="section-sub">{{ landing.rules.copy }}</p>
      </div>
      <div class="priority-pill">Top priority</div>
    </div>

    <div class="rules-intro">
      <div class="callout">
        <strong>Key principle</strong>
        <p>Qualify through consistent, verifiable participation, not competition.</p>
      </div>
      <div class="warning">
        <strong>Automatic disqualification triggers</strong>
        <ul class="checklist checklist--warning">
          <li>Missing a required weekly update.</li>
          <li>Joining more than one project.</li>
          <li>Failing to provide verifiable public evidence.</li>
        </ul>
      </div>
    </div>

    <div class="rule-group">
      <h3 class="rule-group-title">The Builder Track</h3>
      <div class="rules-grid">
        {% for rule in landing.rules.builder %}
          <article class="rule">
            <div class="rule-num">{{ loop.index }}</div>
            <h3>{{ rule.title }}</h3>
            <p>{{ rule.copy }}</p>
          </article>
        {% endfor %}
        <div class="callout tweet-card">
          <strong>Sample Weekly Progress Update</strong>
          <p class="tweet-help">Copy this structure, then replace the body with real progress for the week.</p>
          <div class="mono-box">Week X update - {{ eventTitle }}<br>Built: ...<br>Learned: ...<br>Next: ...<br>{% if weeklyTags %}{{ weeklyTags }} {% endif %}{{ event.weeklyUpdateMention }}</div>
        </div>
      </div>
    </div>

    <div class="rule-group">
      <h3 class="rule-group-title">{{ event.sponsoredTrackName or "Sponsored Track" }}</h3>
      <div class="rules-grid rules-grid--featured">
        {% for rule in landing.rules.sponsorTrack %}
          <article class="rule rule--featured">
            <div class="rule-num">{{ loop.index }}</div>
            <h3>{{ rule.title }}</h3>
            <p>{{ rule.copy }}</p>
          </article>
        {% endfor %}
      </div>
    </div>

    <div class="rule-group">
      <h3 class="rule-group-title">Real User Track</h3>
      <div class="rules-grid">
        {% for rule in landing.rules.realUser %}
          <article class="rule">
            <div class="rule-num">{{ loop.index }}</div>
            <h3>{{ rule.title }}</h3>
            <p>{{ rule.copy }}</p>
          </article>
        {% endfor %}
      </div>
    </div>

    <div class="rule-group">
      <h3 class="rule-group-title">Feedback Track</h3>
      <div class="rules-grid">
        {% for rule in landing.rules.feedback %}
          <article class="rule">
            <div class="rule-num">{{ loop.index }}</div>
            <h3>{{ rule.title }}</h3>
            <p>{{ rule.copy }}</p>
          </article>
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="pop-section split">
    <div id="timeline" class="pop-panel">
      <p class="pop-kicker">Timeline</p>
      <h2 class="section-title">{{ landing.timeline.title }}</h2>
      <p class="section-sub">{{ landing.timeline.copy }}</p>
      <div class="timeline">
        {% for item in landing.timeline.items %}
          <div class="timeline-item">
            <strong>{{ item.title }}</strong>
            {% if item.dateKey == "enrollment" %}
              {{ event.enrollmentStart | readableDate }} to {{ event.enrollmentEnd | readableDate }}. {{ item.copy }}
            {% elif item.dateKey == "build" %}
              Ends {{ event.buildEnd | readableDate }}. {{ item.copy }}
            {% elif item.dateKey == "final" %}
              {{ event.finalPresentationStart | readableDate }} to {{ event.finalPresentationEnd | readableDate }}. {{ item.copy }}
            {% elif item.dateKey == "payout" %}
              {{ event.payoutStart | readableDate }} to {{ event.payoutEnd | readableDate }}. {{ item.copy }}
            {% else %}
              {{ item.copy }}
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>

    <div id="register" class="pop-panel">
      <p class="pop-kicker">Registration</p>
      <h2 class="section-title">{{ landing.registration.title }}</h2>
      <p class="section-sub">{{ landing.registration.copy }}</p>
      <div class="timeline">
        {% for step in landing.registration.steps %}
          <div class="timeline-item">
            <strong>{{ step.title }}</strong>
            {{ step.copy }}
          </div>
        {% endfor %}
      </div>
      <div class="footer-actions">
        <a class="pop-btn pop-btn-primary" href="{{ registrationUrl }}">Register</a>
        <a class="pop-btn pop-btn-secondary" href="https://github.com">Create empty public repo</a>
      </div>
    </div>
  </section>

  <section id="faq" class="pop-section pop-panel faq-panel">
    <div class="section-head">
      <div>
        <p class="pop-kicker">FAQ</p>
        <h2 class="section-title">{{ landing.faq.title }}</h2>
      </div>
    </div>
    <div class="faq-list">
      {% for item in landing.faq.items %}
        <details>
          <summary>{{ item.question }}</summary>
          <p>{{ item.answer }}</p>
        </details>
      {% endfor %}
    </div>
  </section>

  <section id="community" class="source-truth">
    <div class="source-truth-panel">
      <h2 class="source-truth-title">{{ landing.community.title }}</h2>
      <p class="source-truth-sub">{{ landing.community.copy }}</p>
      <div class="source-truth-links">
        <a class="source-truth-link" href="{{ event.githubOrgUrl or '#' }}">
          <p class="source-truth-link-text">Open the official repository or community GitHub.</p>
          <span class="source-truth-link-icon">git</span>
        </a>
        <a class="source-truth-link" href="{{ event.discordUrl or '#' }}">
          <p class="source-truth-link-text">Join the community Discord for questions and feedback sessions.</p>
          <span class="source-truth-link-icon">chat</span>
        </a>
        <a class="source-truth-link" href="{{ '/use-this-model/' | withBase }}">
          <p class="source-truth-link-text">Use this model for another builder season.</p>
          <span class="source-truth-link-icon">fork</span>
        </a>
      </div>
    </div>
  </section>
</div>
{% endblock %}
