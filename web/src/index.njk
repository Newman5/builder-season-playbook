{% extends "base.njk" %}

{% block title %}Builder Season Playbook{% endblock %}

{% block content %}
<section class="hero split">
  <div>
    <p class="eyebrow">Builder Season Surface</p>
    <h2 style="margin-top: 0;">One public site for weekly momentum and long-form progress.</h2>
    <p>
      This site combines a lightweight GitHub activity dashboard with the project progress log.
      It is meant to stay transparent, inspectable, and easy to fork.
    </p>
    <div class="button-row">
      <a class="button" href="{{ '/dashboard/' | withBase }}">Open Dashboard</a>
      {# <a class="button secondary" href="{{ '/progress-log/' | withBase }}">Read Progress Log</a> #}
    </div>
  </div>
  
</section>

<section class="card facepile-section">
  <div class="facepile-copy">
    <p class="eyebrow">Builder Registry</p>
    <h2 style="margin-top: 0;">The season is shaped by public work from a growing circle of builders.</h2>

  </div>
  <ul class="facepile" aria-label="Builder profile images">
    {% for builder in builders %}
      {% if builder.githubAvatarUrl %}
        {% set profileLink = builder.builderPageUrl %}
        <li>
          <a
            class="facepile-link"
            href="{% if profileLink %}{{ profileLink | withBase }}{% else %}{{ builder.githubProfileUrl }}{% endif %}"
            {% if not profileLink %}rel="external noopener"{% endif %}
            title="{{ builder.displayName }}"
            aria-label="Open {{ builder.displayName }}"
          >
            <img
              class="facepile-avatar"
              src="{{ builder.githubAvatarUrl }}"
              alt="{{ builder.displayName }} GitHub profile image"
              width="48"
              height="48"
              loading="lazy"
              decoding="async"
            >
          </a>
        </li>
      {% endif %}
    {% endfor %}
  </ul>
  
</section>
{% endblock %}
