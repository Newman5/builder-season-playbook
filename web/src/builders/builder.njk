---
pagination:
  data: builders
  size: 1
  alias: builder
permalink: "/builders/{{ builder.id }}/index.html"
eleventyComputed:
  title: "{{ builder.name }}"
---

{% extends "base.njk" %}

{% set record = activity | activityForBuilder(builder.id) %}
{% set xPieceOfPieUrl = builder.x | xPieceOfPieSearchUrl %}

{% block title %}{{ builder.name }}{% endblock %}

{% block content %}
<section class="hero">
  <p class="eyebrow">Builder Detail</p>
  <h2 style="margin-top: 0;">{{ builder.name }}</h2>
  {% if builder.tagline %}
    <p class="muted" style="margin-top: 0;">{{ builder.tagline }}</p>
  {% endif %}
  <p>
    {% if builder.projectUrl %}
      <a href="{{ builder.projectUrl }}">{{ builder.projectName or "Project link" }}</a>
    {% else %}
      {{ builder.projectName or "Project link not listed yet." }}
    {% endif %}
  </p>
</section>

<section class="split">
  <article class="table-card">
    <h2>Profile</h2>
    <ul class="clean">
      <li><strong>GitHub:</strong> <a href="https://github.com/{{ builder.github }}">@{{ builder.github }}</a></li>
      {% if builder.x %}
        <li><strong>X:</strong> <a href="{{ xPieceOfPieUrl }}">Search @{{ builder.x }} for pieceofpie</a></li>
      {% endif %}
      {% if builder.status %}
        <li><strong>Status:</strong> {{ builder.status }}</li>
      {% endif %}
      {% if builder.repoUrl %}
        <li><strong>Tracked repo:</strong> <a href="{{ builder.repoUrl }}">{{ builder.repoUrl }}</a></li>
      {% endif %}
      {% if builder.demoUrl %}
        <li><strong>Demo:</strong> <a href="{{ builder.demoUrl }}">{{ builder.demoUrl }}</a></li>
      {% endif %}
      {% if builder.websiteUrl %}
        <li><strong>Website:</strong> <a href="{{ builder.websiteUrl }}">{{ builder.websiteUrl }}</a></li>
      {% endif %}
      {% if builder.pies and builder.pies.length %}
        <li><strong>Pies:</strong> {{ builder.pies | join(", ") }}</li>
      {% endif %}
      {% if builder.notes %}
        <li><strong>Notes:</strong> {{ builder.notes }}</li>
      {% endif %}
    </ul>
  </article>

  <article class="table-card">
    <h2>Activity</h2>
    <p class="muted">GitHub activity uses the current UTC week.</p>
    <p><strong>Commits this week:</strong> {{ record.commitsThisWeek if record else 0 }}</p>
    <p><strong>Last activity:</strong>
      {% if record and record.lastActivityAt %}
        {{ record.lastActivityAt | readableDateTime }}
      {% elseif record and record.error %}
        {{ record.error }}
      {% else %}
        No recent activity detected
      {% endif %}
    </p>
  </article>
</section>

<section class="table-card" style="margin-top: 24px;">
  <h2>Project Updates</h2>
  {% if builder.updates and builder.updates.length %}
    <ul class="clean">
      {% for update in builder.updates %}
        <li>
          <strong>Week {{ update.week or "?" }}</strong>{% if update.date %} · {{ update.date | readableDate }}{% endif %}<br>
          {% if update.summary %}{{ update.summary }}<br>{% endif %}
          {% if update.xUrl %}<a href="{{ update.xUrl }}">Open X update</a>{% endif %}
        </li>
      {% endfor %}
    </ul>
  {% elseif builder.projectMetadataError and builder.projectMetadataError != "NOT_FOUND" %}
    <p class="muted">Project metadata is unavailable right now: {{ builder.projectMetadataError }}</p>
  {% else %}
    <p class="muted">No project updates are listed yet.</p>
  {% endif %}
</section>

<section class="table-card" style="margin-top: 24px;">
  <h2>Recent Commits</h2>
  {% if record and record.recentCommits and record.recentCommits.length %}
    <ul class="clean">
      {% for commit in record.recentCommits %}
        <li>
          <a href="{{ commit.url }}">{{ commit.message }}</a><br>
          <span class="muted">{{ commit.repo }} · {{ commit.committedAt | readableDateTime }}</span>
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p class="muted">No recent commits captured for this builder in the current snapshot.</p>
  {% endif %}
</section>
{% endblock %}
