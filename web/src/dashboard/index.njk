---
title: Builder Activity Dashboard
permalink: /dashboard/
---

{% extends "base.njk" %}

{% set summary = builders | activitySummary(activity) %}
{% set commitFeed = activity | flattenRecentCommits %}
{% set xSummary = builders | xSearchSummary(xSearch) %}

{% block title %}Builder Activity Dashboard{% endblock %}

{% block content %}
<section class="hero">
  <p class="eyebrow">Dashboard</p>
  <h2 style="margin-top: 0;">Weekly public GitHub activity across tracked builder repos</h2>
  <p>The X.com search is here for tracking updates during the hackathon weeks. But it is really buggy, so your tweets might not show up.  Just be aware that the data may not be complete and record your Post urls for the final presentation</p>
</section>

<section class="card-grid" style="margin-bottom: 24px;">
  <article class="card">
    <p class="eyebrow">Total Builders</p>
    <p class="stat">{{ summary.totalBuilders }}</p>
  </article>
  <article class="card">
    <p class="eyebrow">Active This Week</p>
    <p class="stat">{{ summary.activeThisWeek }}</p>
  </article>
  <article class="card">
    <p class="eyebrow">Commits This Week</p>
    <p class="stat">{{ summary.totalCommitsThisWeek }}</p>
  </article>
  <article class="card">
    <p class="eyebrow">Last Updated</p>
    <p style="margin: 0;">{{ summary.lastUpdated | readableDateTime }}</p>
  </article>
    <article class="card">
    <p class="eyebrow">Current Admin Week</p>
    <p class="stat">{{ xSummary.currentAdminWeekIndex or "Off Cycle" }}</p>
  </article>
    <article class="card">
    <p class="eyebrow">Hackathon Weeks</p>
    <p class="stat">{{ xSummary.weeks }}</p>
  </article>
  <article class="card">
    <p class="eyebrow">Search for updates</p>
    {% if xSummary.currentAdminWeekIndex %}
  {% set currentWeek = xSearch.weeks[xSummary.currentAdminWeekIndex - 1] %}
  <p style="margin: 0;"><a href="{{ currentWeek.searchUrl }}">Week {{ xSummary.currentAdminWeekIndex }} on X</a></p>
{% else %}
  <p style="margin: 0;">{{ xSearch.weeklyUpdateMention or "None" }}</p>
{% endif %}
  </article>
</section>



<section class="table-card" style="margin-bottom: 24px;">
  <h2>Builders</h2>
  <ul class="facepile" aria-label="Builder profile images">
    {% for builder in builders %}
      {% if builder.githubAvatarUrl %}
        {% set profileLink = builder.builderPageUrl %}
        <li>
          <a
            class="facepile-link"
            href="{% if profileLink %}{{ profileLink | withBase }}{% else %}{{ builder.githubProfileUrl }}{% endif %}"
            {% if not profileLink %}rel="external noopener"{% endif %}
            title="{{ builder.displayName }}"
            aria-label="Open {{ builder.displayName }}"
          >
            <img
              class="facepile-avatar"
              src="{{ builder.githubAvatarUrl }}"
              alt="{{ builder.displayName }} GitHub profile image"
              width="48"
              height="48"
              loading="lazy"
              decoding="async"
            >
          </a>
        </li>
      {% endif %}
    {% endfor %}
  </ul>
  <table>
    <thead>
      <tr>
        <th>Builder</th>
        <th>Project</th>
        <th>Repo</th>
        <th>Commits</th>
        <th>Last Activity</th>
        <th>Details</th>
      </tr>
    </thead>
    <tbody>
      {% for builder in builders %}
        {% set record = activity | activityForBuilder(builder.id) %}
        <tr>
          <td data-label="Builder">
            <strong>{{ builder.name }}</strong><br>
            <span class="muted"><a href="https://x.com/{{ builder.x }}">@{{ builder.x }}</a></span>
          </td>
          <td data-label="Project">
            {% if builder.projectUrl %}
              <a href="{{ builder.projectUrl }}">{{ builder.projectName or "Project Link" }}</a>
            {% else %}
              {{ builder.projectName or "Not listed" }}
            {% endif %}
          </td>
          <td data-label="Repo">
            {% if builder.repoUrl %}
              <a href="{{ builder.repoUrl }}">{{ builder.github }}</a>
            {% else %}
              <span class="muted">Missing</span>
            {% endif %}
          </td>
          <td data-label="Commits">{{ record.commitsThisWeek if record else 0 }}</td>
          <td data-label="Last Activity">
            {% if record and record.lastActivityAt %}
              {{ record.lastActivityAt | readableDateTime }}
            {% elseif record and record.error %}
              <span class="muted">{{ record.error }}</span>
            {% else %}
              <span class="muted">No recent activity</span>
            {% endif %}
          </td>
          <td data-label="Details"><a href="{{ ('/builders/' ~ builder.id ~ '/') | withBase }}">View builder</a></td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
</section>


<section class="table-card" style="margin-bottom: 24px;">
  <details>
    <summary><h2 style="display:inline;">Recent Commits</h2></summary>
    {% if commitFeed.length %}
      <ul class="clean">
        {% for commit in commitFeed | head(12) %}
          <li>
            <strong><a href="{{ ('/builders/' ~ commit.builderId ~ '/') | withBase }}">{{ commit.builderName }}</a></strong>
            committed to <a href="{{ commit.url }}">{{ commit.repo }}</a><br>
            <span>{{ commit.message | truncateCommitMessage(110) }}</span><br>
            <span class="muted">{{ commit.committedAt | readableDateTime }}</span>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p class="muted">No commits captured for the current snapshot.</p>
    {% endif %}
  </details>
</section>

<section class="hero">
  <p class="eyebrow">X Weekly Updates</p>
  <h2 style="margin-top: 0;">Manual X search links by week</h2>
  <p>This dashboard generates X live-search links from <code>config/repos.yml</code> and <code>config/event.yml</code>. Admin weeks always run Monday to Sunday, so Hackathon Week 1 is Apr 13 to Apr 19, 2026. A builder's Week 1 update can happen in a later admin week; the builder schedule below shows that offset without changing the admin week labels.</p>
</section>


<section class="table-card" style="margin-bottom: 24px;">
  <details>
    <summary>Weekly Global Searches</summary>
    {% if xSummary.configError %}
      <p class="muted">X search configuration error: {{ xSummary.configError }}</p>
    {% else %}
      <p class="muted">Admin week numbers are the canonical labels used by the dashboard and the search links below.</p>
      <ul class="clean">
        {% for week in xSearch.weeks %}
          <li>
            <strong>{{ week.label }}</strong> · {{ week.dateRangeLabel }}<br>
            <a href="{{ week.searchUrl }}">Open live search</a>
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </details>
</section>
{% endblock %}
