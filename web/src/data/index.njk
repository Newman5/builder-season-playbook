{% extends "base.njk" %}

{% block title %}Data{% endblock %}

{% block content %}
<section class="hero">
  <p class="eyebrow">Raw Data</p>
  <h2 style="margin-top: 0;">Published JSON used by the site</h2>
  <p>This page links to the normalized builder registry, fetched project metadata, and the generated GitHub activity snapshot.</p>
</section>

<section class="card-grid">
  <article class="card">
    <h2>Builder Registry</h2>
    <p>Merged builder JSON generated from <code>config/repos.yml</code> plus fetched <code>project.yml</code> overlays when present.</p>
    <a class="button secondary" href="{{ '/data/builders.json' | withBase }}">Open builders.json</a>
  </article>
  <article class="card">
    <h2>Project Metadata Cache</h2>
    <p>Fetched root-level <code>project.yml</code> records cached under <code>src/_data/</code> for the site build.</p>
    <a class="button secondary" href="{{ '/data/project-metadata.json' | withBase }}">Open project-metadata.json</a>
  </article>
  <article class="card">
    <h2>Activity Snapshot</h2>
    <p>Generated GitHub activity data for the current UTC week.</p>
    <a class="button secondary" href="{{ '/data/activity.json' | withBase }}">Open activity.json</a>
  </article>
</section>
{% endblock %}
