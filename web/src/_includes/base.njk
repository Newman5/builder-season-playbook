<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}Builder Season Playbook{% endblock %}</title>

  <meta property="og:image" content="{{ (og_image or '/images/og/11ty-blog-OG-default.jpg') | withBase }}">
  <meta property="og:title" content="{{ title or 'Builder Season Playbook' }}">
  <meta property="og:description" content="{{ description or 'Open web dashboard and progress log for Builder Season.' }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ page.url | withBase }}">

  <link rel="alternate" href="{{ '/feed/feed.xml' | withBase }}" type="application/atom+xml" title="Builder Season Playbook RSS Feed">

  <style>
    :root {
      --bg: #f7f5ef;
      --surface: #fffefa;
      --surface-quiet: #f0eee7;
      --text: #181715;
      --muted: #666158;
      --border: #d8d2c4;
      --border-strong: #b9b09f;
      --accent: #8f4b2d;
      --accent-dark: #5f301f;
      --card: #fffefa;
      --ink: #24211d;
      --code-bg: #ebe7dc;
      --pop-bg: #140f2d;
      --pop-text: #fffdf8;
      --pop-panel: #fffdf8;
      --pop-ink: #171225;
      --pop-muted: #d9d3e8;
      --pop-border: #06040d;
      --pop-shadow: #06040d;
      --pop-crimson: #d72638;
      --pop-blue: #3f88c5;
      --pop-orange: #f49d37;
      --pop-red: #f22b29;
    }

    * {
      box-sizing: border-box;
    }

    body {
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      line-height: 1.6;
      margin: 0;
      color: var(--pop-text);
      background:
        radial-gradient(circle at 18% 14%, rgba(244, 157, 55, 0.22) 0, transparent 28%),
        radial-gradient(circle at 82% 12%, rgba(63, 136, 197, 0.18) 0, transparent 24%),
        linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px),
        linear-gradient(180deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px),
        var(--pop-bg);
      background-size: auto, auto, 44px 44px, 44px 44px, auto;
    }

    .shell {
      max-width: 1160px;
      margin: 0 auto;
      padding: 20px 24px 34px;
    }

    header {
      border: 0;
      margin-bottom: 18px;
      padding-bottom: 6px;
    }

    header h1 {
      margin: 0;
      font-family: Inter, ui-sans-serif, system-ui, sans-serif;
      font-size: clamp(1.05rem, 2.2vw, 1.3rem);
      font-weight: 900;
      letter-spacing: 0;
      color: var(--pop-text);
    }

    header h1 a::before {
      content: "BS";
      display: inline-grid;
      place-items: center;
      width: 46px;
      height: 46px;
      margin-right: 12px;
      border: 3px solid var(--pop-border);
      border-radius: 50%;
      background: var(--pop-orange);
      box-shadow: 4px 4px 0 var(--pop-shadow);
      color: var(--pop-ink);
      font-size: 1rem;
      vertical-align: middle;
    }

    header p {
      margin: 8px 0 0;
      color: var(--pop-muted);
      max-width: 48rem;
      font-size: 0.98rem;
    }

    nav {
      margin-top: 16px;
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    nav a {
      padding: 8px 14px;
      border: 2px solid var(--pop-border);
      border-radius: 12px;
      background: var(--pop-panel);
      box-shadow: 3px 3px 0 var(--pop-shadow);
      color: var(--pop-ink);
      text-decoration: none;
      font-size: 0.92rem;
      font-weight: 900;
      transition: transform 120ms ease, box-shadow 120ms ease;
    }

    nav a:hover,
    nav a:focus-visible {
      transform: translate(-2px, -2px);
      box-shadow: 5px 5px 0 var(--pop-shadow);
      color: var(--pop-ink);
      outline: none;
    }

    main {
      min-height: 60vh;
    }

    footer {
      margin-top: 60px;
      padding-top: 20px;
      border-top: 1px solid rgba(255, 253, 248, 0.22);
      color: var(--pop-muted);
      font-size: 0.9em;
    }

    footer a {
      color: var(--pop-orange);
    }

    a {
      color: var(--accent);
    }

    a:hover {
      color: var(--accent-dark);
    }

    pre {
      background: var(--code-bg);
      padding: 15px;
      overflow-x: auto;
      border-radius: 6px;
    }

    code {
      background: var(--code-bg);
      padding: 2px 6px;
      border-radius: 3px;
      font-size: 0.92em;
    }

    .card-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 18px;
    }

    .card,
    .table-card {
      position: relative;
      overflow: hidden;
      background: var(--pop-panel);
      border: 3px solid var(--pop-border);
      border-radius: 24px;
      padding: 18px;
      box-shadow: 8px 8px 0 var(--pop-shadow);
      color: var(--pop-ink);
    }

    .table-card {
      padding: 24px;
    }

    .card::after,
    .table-card::after {
      content: "";
      position: absolute;
      inset: auto -42px -72px auto;
      width: 160px;
      height: 160px;
      border: 2px solid rgba(20, 15, 45, 0.12);
      border-radius: 50%;
      pointer-events: none;
    }

    .card h2,
    .table-card h2,
    .table-card h3 {
      margin-top: 0;
      color: var(--pop-ink);
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 14px;
      border: 2px solid var(--pop-border);
      border-radius: 999px;
      background: rgba(63, 136, 197, 0.22);
      box-shadow: 3px 3px 0 var(--pop-shadow);
      color: var(--pop-ink);
      font-size: 0.82rem;
      letter-spacing: 0;
      text-transform: uppercase;
      margin: 0 0 8px;
      font-weight: 900;
    }

    .stat {
      color: var(--pop-crimson);
      font-size: 2.4rem;
      font-weight: 900;
      line-height: 1;
      margin: 0;
    }

    .button-row {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 24px;
    }

    .button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      background: var(--pop-crimson);
      color: #fffdf8;
      padding: 10px 18px;
      border: 3px solid var(--pop-border);
      border-radius: 12px;
      box-shadow: 4px 4px 0 var(--pop-shadow);
      text-decoration: none;
      font-weight: 900;
      line-height: 1.15;
      transition: transform 120ms ease, box-shadow 120ms ease;
    }

    .button:hover,
    .button:focus-visible {
      transform: translate(-2px, -2px);
      box-shadow: 6px 6px 0 var(--pop-shadow);
      color: #fffdf8;
      outline: none;
    }

    .button.secondary {
      background: var(--pop-orange);
      color: var(--pop-ink);
      border-color: var(--pop-border);
    }

    .text-link {
      display: inline-flex;
      align-items: center;
      color: var(--pop-orange);
      font-weight: 900;
      text-decoration: none;
    }

    .text-link:hover {
      text-decoration: underline;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    th,
    td {
      text-align: left;
      padding: 12px 10px;
      border-bottom: 2px solid rgba(6, 4, 13, 0.12);
      vertical-align: top;
      color: var(--pop-ink);
    }

    th {
      color: var(--pop-crimson);
      font-size: 0.78rem;
      font-weight: 900;
      text-transform: uppercase;
    }

    ul.clean {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    ul.clean li + li {
      margin-top: 12px;
    }

    .muted {
      color: #5e586e;
    }

    details summary {
      cursor: pointer;
      font-weight: 700;
      color: var(--pop-ink);
      list-style: none;
    }

    details summary::-webkit-details-marker {
      display: none;
    }

    details summary::before {
      content: "▸";
      display: inline-block;
      margin-right: 0.55rem;
      transition: transform 140ms ease;
    }

    details[open] summary::before {
      transform: rotate(90deg);
    }

    details > *:not(summary) {
      margin-top: 16px;
    }

    .hero {
      position: relative;
      overflow: hidden;
      padding: 28px;
      background:
        linear-gradient(135deg, rgba(255, 255, 255, 0.98), rgba(255, 253, 248, 0.94)),
        repeating-linear-gradient(0deg, transparent 0, transparent 25px, rgba(63, 136, 197, 0.18) 26px);
      border: 3px solid var(--pop-border);
      border-radius: 24px;
      box-shadow: 8px 8px 0 var(--pop-shadow);
      color: var(--pop-ink);
      margin-bottom: 28px;
    }

    .hero h2 {
      margin: 0;
      font-family: Inter, ui-sans-serif, system-ui, sans-serif;
      font-size: clamp(2.35rem, 6vw, 4.45rem);
      line-height: 1;
      letter-spacing: 0;
      color: var(--pop-ink);
    }

    .hero p:not(.eyebrow) {
      max-width: 64ch;
      color: #463f58;
      font-size: 1.08rem;
    }

    .split {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 20px;
      align-items: start;
    }

    .facepile-section {
      display: grid;
      gap: 16px;
      align-items: center;
    }

    .facepile-copy {
      max-width: 42rem;
    }

    .facepile {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: 0;
      padding: 0;
      margin: 0;
    }

    .facepile li {
      margin: 0;
    }

    .facepile li + li {
      margin-left: -10px;
    }

    .facepile-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 48px;
      height: 48px;
      border-radius: 999px;
      border: 2px solid rgba(255, 253, 248, 0.95);
      background: #eadfcd;
      box-shadow: 0 8px 22px rgba(53, 39, 29, 0.12);
      overflow: hidden;
      transition: transform 140ms ease, box-shadow 140ms ease, border-color 140ms ease;
    }

    .facepile-link:hover,
    .facepile-link:focus-visible {
      transform: translateY(-2px);
      box-shadow: 0 12px 28px rgba(53, 39, 29, 0.18);
      border-color: rgba(164, 71, 34, 0.65);
      outline: none;
      position: relative;
      z-index: 1;
    }

    .facepile-avatar {
      display: block;
      width: 100%;
      height: 100%;
      border-radius: 999px;
      object-fit: cover;
      background: linear-gradient(135deg, #f4e7d3, #e1c8aa);
    }

    .facepile-caption {
      margin: 0;
      color: var(--muted);
    }

    .landing-hero,
    .landing-section {
      scroll-margin-top: 18px;
    }

    .landing-hero {
      display: grid;
      grid-template-columns: minmax(0, 1.45fr) minmax(320px, 0.8fr);
      gap: 28px;
      align-items: stretch;
      padding: 0;
      margin-bottom: 28px;
    }

    .landing-hero-copy {
      position: relative;
      overflow: hidden;
      padding: 28px;
      border: 3px solid var(--pop-border);
      border-radius: 24px;
      background:
        linear-gradient(135deg, rgba(255, 255, 255, 0.98), rgba(255, 253, 248, 0.94)),
        repeating-linear-gradient(0deg, transparent 0, transparent 25px, rgba(63, 136, 197, 0.18) 26px);
      box-shadow: 8px 8px 0 var(--pop-shadow);
      color: var(--pop-ink);
    }

    .landing-hero-copy::after {
      content: "";
      position: absolute;
      inset: auto -40px -64px auto;
      width: 180px;
      height: 180px;
      border: 2px solid rgba(20, 15, 45, 0.16);
      border-radius: 50%;
      pointer-events: none;
    }

    .landing-hero-copy h2,
    .landing-section h2 {
      font-family: Inter, ui-sans-serif, system-ui, sans-serif;
      letter-spacing: 0;
      line-height: 1;
      color: var(--pop-ink);
    }

    .landing-hero-copy h2 {
      max-width: 16ch;
      margin: 0;
      font-size: clamp(2.35rem, 6vw, 4.45rem);
    }

    .lede {
      max-width: 64ch;
      margin: 16px 0 0;
      color: #463f58;
      font-size: 1.08rem;
    }

    .workflow-panel,
    .example-panel {
      background: var(--pop-panel);
      border: 3px solid var(--pop-border);
      border-radius: 24px;
      box-shadow: 8px 8px 0 var(--pop-shadow);
      color: var(--pop-ink);
    }

    .workflow-panel {
      padding: 18px;
      background:
        linear-gradient(140deg, rgba(63, 136, 197, 0.88), rgba(244, 157, 55, 0.86)),
        var(--pop-blue);
    }

    .panel-header {
      display: flex;
      justify-content: space-between;
      gap: 14px;
      padding-bottom: 12px;
      border-bottom: 2px solid rgba(6, 4, 13, 0.22);
      color: var(--pop-ink);
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
      font-size: 0.78rem;
      font-weight: 900;
    }

    .status-row {
      display: grid;
      grid-template-columns: 76px 1fr;
      gap: 14px;
      align-items: baseline;
      padding: 16px 0;
      border-bottom: 2px solid rgba(6, 4, 13, 0.22);
    }

    .status-row strong {
      font-family: Inter, ui-sans-serif, system-ui, sans-serif;
      font-size: 2rem;
      font-weight: 900;
      line-height: 1;
    }

    .status-row span {
      color: var(--pop-ink);
      font-weight: 800;
    }

    .workflow-list {
      margin: 18px 0 0;
      padding-left: 22px;
      color: var(--pop-ink);
      font-weight: 800;
    }

    .workflow-list li + li {
      margin-top: 8px;
    }

    .landing-section {
      position: relative;
      overflow: hidden;
      padding: 28px;
      margin-bottom: 28px;
      border: 3px solid var(--pop-border);
      border-radius: 24px;
      background: var(--pop-panel);
      box-shadow: 8px 8px 0 var(--pop-shadow);
      color: var(--pop-ink);
    }

    .landing-section::after {
      content: "";
      position: absolute;
      inset: auto -40px -64px auto;
      width: 180px;
      height: 180px;
      border: 2px solid rgba(20, 15, 45, 0.16);
      border-radius: 50%;
      pointer-events: none;
    }

    .split-section,
    .audience-section,
    .support-section {
      display: grid;
      grid-template-columns: minmax(220px, 0.65fr) minmax(0, 1fr);
      gap: 34px;
      align-items: start;
    }

    .landing-section h2 {
      margin: 0;
      font-size: clamp(2.35rem, 6vw, 4.45rem);
    }

    .landing-section h3 {
      margin: 0 0 8px;
      font-size: clamp(1rem, 2.2vw, 1.5rem)
    }

    .landing-section p {
      color: #4a445a;
    }

    .section-heading {
      max-width: 48rem;
      margin-bottom: 28px;
    }

    .section-heading p:not(.eyebrow) {
      font-size: 1.05rem;
    }

    .problem-grid,
    .cadence-grid,
    .included-grid,
    .quote-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .problem-grid article,
    .cadence-grid article,
    .included-grid > div {
      padding: 18px;
      background: #ffffff;
      border: 2px solid var(--pop-border);
      border-radius: 16px;
      box-shadow: 4px 4px 0 var(--pop-shadow);
    }

    .problem-grid p,
    .cadence-grid p {
      margin: 0;
    }

    .step-number,
    .panel-kicker {
      display: block;
      margin-bottom: 10px;
      color: var(--pop-crimson);
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
      font-size: 0.78rem;
      font-weight: 900;
      text-transform: uppercase;
    }

    .check-list {
      margin: 0;
      padding-left: 20px;
      color: #4a445a;
    }

    .check-list li + li {
      margin-top: 8px;
    }

    .example-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
    }

    .example-panel {
      min-height: 180px;
      padding: 18px;
      color: inherit;
      text-decoration: none;
    }

    .example-panel.large {
      grid-column: span 2;
      min-height: 320px;
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(255, 253, 248, 0.9)),
        repeating-linear-gradient(90deg, transparent 0, transparent 22px, rgba(20, 15, 45, 0.08) 23px);
    }

    .example-panel:hover {
      transform: translate(-2px, -2px);
      box-shadow: 10px 10px 0 var(--pop-shadow);
      color: var(--pop-ink);
    }

    .example-panel strong {
      display: block;
      max-width: 28rem;
      font-size: 1.08rem;
      line-height: 1.35;
    }

    .mini-table {
      display: grid;
      grid-template-columns: 1fr 1fr 80px;
      margin-top: 28px;
      border: 2px solid var(--pop-border);
      border-radius: 12px;
      overflow: hidden;
      color: var(--pop-ink);
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
      font-size: 0.78rem;
    }

    .mini-table span {
      padding: 10px;
      border-right: 2px solid var(--pop-border);
      border-bottom: 2px solid var(--pop-border);
      background: #ffffff;
    }

    .mini-table span:nth-child(3n) {
      border-right: 0;
    }

    .mini-table span:nth-last-child(-n + 3) {
      border-bottom: 0;
    }

    .tag-list {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .tag-list li {
      padding: 8px 11px;
      background: #ffffff;
      border: 2px solid var(--pop-border);
      border-radius: 999px;
      box-shadow: 3px 3px 0 var(--pop-shadow);
      color: var(--pop-ink);
      font-size: 0.92rem;
      font-weight: 900;
    }

    .quote-grid blockquote {
      margin: 0;
      padding: 22px;
      background: var(--pop-crimson);
      border: 3px solid var(--pop-border);
      border-radius: 16px;
      box-shadow: 4px 4px 0 var(--pop-shadow);
      color: #fffefa;
      font-family: Inter, ui-sans-serif, system-ui, sans-serif;
      font-weight: 900;
      font-size: clamp(1.35rem, 3vw, 2.2rem);
      line-height: 1.15;
    }

    .support-section {
      border-bottom: 0;
    }

    .support-section p {
      max-width: 46rem;
      font-size: 1.05rem;
    }

    .support-actions {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      padding: 18px;
      background: #fff8ea;
      border: 2px solid var(--pop-border);
      border-radius: 16px;
      box-shadow: 4px 4px 0 var(--pop-shadow);
    }

    body.event-landing {
      --pop-bg: #140f2d;
      --pop-text: #fffdf8;
      --pop-panel: #fffdf8;
      --pop-ink: #171225;
      --pop-muted: #d9d3e8;
      --pop-border: #06040d;
      --pop-shadow: #06040d;
      --pop-crimson: #d72638;
      --pop-blue: #3f88c5;
      --pop-orange: #f49d37;
      --pop-red: #f22b29;
      color: var(--pop-text);
      background:
        radial-gradient(circle at 18% 14%, rgba(244, 157, 55, 0.22) 0, transparent 28%),
        radial-gradient(circle at 82% 12%, rgba(63, 136, 197, 0.18) 0, transparent 24%),
        linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px),
        linear-gradient(180deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px),
        var(--pop-bg);
      background-size: auto, auto, 44px 44px, 44px 44px, auto;
    }

    body.event-landing .shell {
      max-width: 1160px;
      padding: 20px 24px 34px;
    }

    body.event-landing header {
      border: 0;
      margin-bottom: 18px;
      padding-bottom: 6px;
    }

    body.event-landing header h1 {
      font-family: Inter, ui-sans-serif, system-ui, sans-serif;
      font-size: clamp(1.05rem, 2.2vw, 1.3rem);
      font-weight: 900;
      color: var(--pop-text);
    }

    body.event-landing header h1 a::before {
      content: "BS";
      display: inline-grid;
      place-items: center;
      width: 46px;
      height: 46px;
      margin-right: 12px;
      border: 3px solid var(--pop-border);
      border-radius: 50%;
      background: var(--pop-orange);
      box-shadow: 4px 4px 0 var(--pop-shadow);
      color: var(--pop-ink);
      font-size: 1rem;
      vertical-align: middle;
    }

    body.event-landing header p {
      color: var(--pop-muted);
    }

    body.event-landing nav {
      gap: 10px;
    }

    body.event-landing nav a {
      padding: 8px 14px;
      border: 2px solid var(--pop-border);
      border-radius: 12px;
      background: var(--pop-panel);
      box-shadow: 3px 3px 0 var(--pop-shadow);
      color: var(--pop-ink);
      font-weight: 900;
      text-decoration: none;
      transition: transform 120ms ease, box-shadow 120ms ease;
    }

    body.event-landing nav a:hover,
    body.event-landing nav a:focus-visible {
      transform: translate(-2px, -2px);
      box-shadow: 5px 5px 0 var(--pop-shadow);
      outline: none;
    }

    body.event-landing footer {
      border-color: rgba(255, 253, 248, 0.22);
      color: var(--pop-muted);
    }

    body.event-landing footer a {
      color: var(--pop-orange);
    }

    .pop-page {
      display: grid;
      gap: 28px;
    }

    .pop-panel {
      position: relative;
      overflow: hidden;
      padding: 28px;
      border: 3px solid var(--pop-border);
      border-radius: 24px;
      background: var(--pop-panel);
      box-shadow: 8px 8px 0 var(--pop-shadow);
      color: var(--pop-ink);
    }

    .pop-panel::after {
      content: "";
      position: absolute;
      inset: auto -40px -64px auto;
      width: 180px;
      height: 180px;
      border: 2px solid rgba(20, 15, 45, 0.16);
      border-radius: 50%;
      pointer-events: none;
    }

    .pop-hero {
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(300px, 0.8fr);
      gap: 28px;
      align-items: stretch;
    }

    .pop-hero-copy {
      background:
        linear-gradient(135deg, rgba(255, 255, 255, 0.98), rgba(255, 253, 248, 0.94)),
        repeating-linear-gradient(0deg, transparent 0, transparent 25px, rgba(63, 136, 197, 0.18) 26px);
    }

    .pop-eyebrow,
    .pop-kicker {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 14px;
      border: 2px solid var(--pop-border);
      border-radius: 999px;
      background: rgba(63, 136, 197, 0.22);
      box-shadow: 3px 3px 0 var(--pop-shadow);
      color: var(--pop-ink);
      font-size: 0.82rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0;
      margin: 0 0 18px;
    }

    .pop-hero h2,
    .section-title,
    .sponsor-title,
    .source-truth-title {
      margin: 0;
      font-family: Inter, ui-sans-serif, system-ui, sans-serif;
      font-size: clamp(2.35rem, 6vw, 4.45rem);
      line-height: 1;
      letter-spacing: 0;
      color: var(--pop-ink);
    }

    .pop-lead,
    .section-sub,
    .sponsor-copy,
    .source-truth-sub {
      max-width: 64ch;
      margin: 16px 0 0;
      color: #463f58;
      font-size: 1.08rem;
    }

    .pop-actions,
    .footer-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin-top: 28px;
    }

    .pop-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      padding: 10px 18px;
      border: 3px solid var(--pop-border);
      border-radius: 12px;
      box-shadow: 4px 4px 0 var(--pop-shadow);
      color: var(--pop-ink);
      font-weight: 900;
      line-height: 1.15;
      text-decoration: none;
      transition: transform 120ms ease, box-shadow 120ms ease;
    }

    .pop-btn:hover,
    .pop-btn:focus-visible {
      transform: translate(-2px, -2px);
      box-shadow: 6px 6px 0 var(--pop-shadow);
      color: var(--pop-ink);
      outline: none;
    }

    .pop-btn-primary {
      background: var(--pop-crimson);
      color: #fffdf8;
    }

    .pop-btn-primary:hover,
    .pop-btn-primary:focus-visible {
      color: #fffdf8;
    }

    .pop-btn-secondary {
      background: var(--pop-orange);
    }

    .pop-btn-quiet {
      background: #ffffff;
    }

    .pop-hero-side {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 18px;
      background:
        linear-gradient(140deg, rgba(63, 136, 197, 0.88), rgba(244, 157, 55, 0.86)),
        var(--pop-blue);
    }

    .pop-hero-side p {
      margin: 0;
      color: var(--pop-ink);
      font-weight: 800;
    }

    .pop-sticker {
      position: absolute;
      top: 16px;
      right: 16px;
      transform: rotate(10deg);
      padding: 7px 12px;
      border: 2px solid var(--pop-border);
      border-radius: 8px;
      background: #fffdf8;
      box-shadow: 3px 3px 0 var(--pop-shadow);
      font-size: 0.86rem;
      font-weight: 900;
    }

    .mini-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .mini {
      padding: 12px;
      border: 2px solid var(--pop-border);
      border-radius: 12px;
      background: #fffdf8;
      box-shadow: 3px 3px 0 var(--pop-shadow);
      color: var(--pop-ink);
      font-weight: 800;
    }

    .mini strong {
      display: block;
      margin-bottom: 4px;
      color: var(--pop-crimson);
      font-size: 0.86rem;
      text-transform: uppercase;
    }

    .pop-section {
      scroll-margin-top: 18px;
    }

    .section-head {
      display: flex;
      justify-content: space-between;
      gap: 24px;
      align-items: flex-start;
      margin-bottom: 24px;
    }

    .priority-pill {
      flex: 0 0 auto;
      max-width: 250px;
      padding: 12px 14px;
      border: 2px solid var(--pop-border);
      border-radius: 14px;
      background: var(--pop-orange);
      box-shadow: 4px 4px 0 var(--pop-shadow);
      color: var(--pop-ink);
      font-weight: 900;
    }

    .availability-pill {
      background: var(--pop-crimson);
      color: #fffdf8;
    }

    .availability-pill span {
      display: block;
      margin-top: 4px;
      font-size: 0.86rem;
    }

    .overview-grid,
    .rules-grid,
    .pie-share-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .rule,
    .pie-share-card,
    .kanban-card,
    .timeline-item,
    .callout,
    .warning,
    .source-truth-link,
    .faq-list details {
      border: 2px solid var(--pop-border);
      border-radius: 16px;
      background: #ffffff;
      box-shadow: 4px 4px 0 var(--pop-shadow);
    }

    .rule,
    .pie-share-card,
    .kanban-card,
    .callout,
    .warning,
    .faq-list details {
      padding: 18px;
    }

    .rule-num {
      display: inline-grid;
      place-items: center;
      width: 34px;
      height: 34px;
      margin-bottom: 12px;
      border: 2px solid var(--pop-border);
      border-radius: 50%;
      background: var(--pop-blue);
      color: #fffdf8;
      font-weight: 900;
    }

    .rule h3,
    .pie-share-card h3,
    .kanban-card h3 {
      margin: 0 0 8px;
      font-size: 1.08rem;
      line-height: 1.2;
    }

    .rule p,
    .pie-share-card p,
    .kanban-card p,
    .timeline-item,
    .callout p,
    .warning p,
    .faq-list p {
      margin: 0;
      color: #4a445a;
    }

    .kanban-board {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 14px;
    }

    .kanban-card {
      min-height: 190px;
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(255, 253, 248, 0.9)),
        repeating-linear-gradient(90deg, transparent 0, transparent 22px, rgba(20, 15, 45, 0.08) 23px);
    }

    .kanban-card span {
      display: block;
      margin-bottom: 28px;
      color: var(--pop-crimson);
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-weight: 900;
    }

    .pie-share-overview,
    .rules-intro,
    .sponsor-layout {
      display: grid;
      grid-template-columns: minmax(260px, 0.8fr) minmax(0, 1.2fr);
      gap: 20px;
      align-items: stretch;
    }

    .pie-pool-card {
      padding: 20px;
      border: 2px solid var(--pop-border);
      border-radius: 18px;
      background: #ffffff;
      box-shadow: 4px 4px 0 var(--pop-shadow);
    }

    .pie-chart {
      display: grid;
      place-items: center;
      width: min(230px, 100%);
      aspect-ratio: 1;
      margin: 0 auto 18px;
      border: 3px solid var(--pop-border);
      border-radius: 50%;
      background: conic-gradient(
        var(--pop-crimson) 0 31%,
        var(--pop-blue) 31% 91%,
        var(--pop-orange) 91% 97%,
        var(--pop-red) 97% 100%
      );
      box-shadow: 5px 5px 0 var(--pop-shadow);
    }

    .pie-hole {
      display: grid;
      place-items: center;
      width: 48%;
      aspect-ratio: 1;
      border: 2px solid var(--pop-border);
      border-radius: 50%;
      background: #fffdf8;
      text-align: center;
      font-weight: 900;
    }

    .pie-hole span {
      color: #5e586e;
      font-size: 0.78rem;
      text-transform: uppercase;
    }

    .pie-legend {
      display: grid;
      gap: 8px;
      font-size: 0.9rem;
      font-weight: 800;
    }

    .pie-legend-item {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .pie-dot {
      width: 13px;
      height: 13px;
      border: 2px solid var(--pop-border);
      border-radius: 50%;
      background: var(--pop-crimson);
    }

    .pie-dot--cardano {
      background: var(--pop-blue);
    }

    .pie-dot--user {
      background: var(--pop-orange);
    }

    .pie-dot--feedback {
      background: var(--pop-red);
    }

    .sponsor-panel {
      background: linear-gradient(135deg, #fffdf8, #e8f4ff);
    }

    .sponsor-logo-card {
      display: grid;
      place-items: center;
      min-height: 190px;
      border: 3px solid var(--pop-border);
      border-radius: 22px;
      background: var(--pop-blue);
      box-shadow: 6px 6px 0 var(--pop-shadow);
      color: #fffdf8;
      font-size: clamp(3rem, 8vw, 5.5rem);
      font-weight: 900;
    }

    .sponsor-kicker {
      display: block;
      margin-bottom: 10px;
      color: var(--pop-crimson);
      font-weight: 900;
      text-transform: uppercase;
    }

    .rules-intro {
      margin-bottom: 24px;
    }

    .warning {
      background: #fff2f1;
    }

    .warning strong {
      color: var(--pop-red);
    }

    .checklist {
      margin: 10px 0 0;
      padding-left: 20px;
      color: #4a445a;
    }

    .rule-group {
      margin-top: 30px;
    }

    .rule-group-title {
      margin: 0 0 14px;
      font-size: clamp(1.4rem, 3vw, 2rem);
    }

    .rule--featured {
      grid-column: 1 / -1;
      background: #f7fbff;
    }

    .tweet-card {
      grid-column: 1 / -1;
      background: #fff8ea;
    }

    .tweet-help {
      margin: 8px 0 12px;
    }

    .mono-box {
      padding: 14px;
      border: 2px solid var(--pop-border);
      border-radius: 12px;
      background: var(--pop-bg);
      color: #fffdf8;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 0.9rem;
      line-height: 1.5;
    }

    body.event-landing .split {
      grid-template-columns: minmax(0, 1fr) minmax(300px, 0.85fr);
      gap: 28px;
    }

    .timeline {
      display: grid;
      gap: 14px;
      margin-top: 18px;
    }

    .timeline-item {
      position: relative;
      padding: 16px 16px 16px 46px;
    }

    .timeline-item::before {
      content: "";
      position: absolute;
      left: 16px;
      top: 20px;
      width: 14px;
      height: 14px;
      border: 2px solid var(--pop-border);
      border-radius: 50%;
      background: var(--pop-orange);
    }

    .timeline-item strong {
      display: block;
      margin-bottom: 4px;
      color: var(--pop-ink);
    }

    .faq-list {
      display: grid;
      gap: 12px;
    }

    .faq-list details summary {
      color: var(--pop-ink);
      font-weight: 900;
    }

    .faq-list details > *:not(summary) {
      margin-top: 10px;
    }

    .source-truth {
      padding: 4px 0 0;
    }

    .source-truth-panel {
      padding: 28px;
      border: 3px solid var(--pop-border);
      border-radius: 24px;
      background: var(--pop-crimson);
      box-shadow: 8px 8px 0 var(--pop-shadow);
      color: #fffdf8;
    }

    .source-truth-title,
    .source-truth-sub {
      color: #fffdf8;
    }

    .source-truth-links {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
      margin-top: 22px;
    }

    .source-truth-link {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 14px;
      align-items: center;
      padding: 16px;
      color: var(--pop-ink);
      text-decoration: none;
    }

    .source-truth-link:hover {
      color: var(--pop-ink);
      transform: translate(-2px, -2px);
      box-shadow: 6px 6px 0 var(--pop-shadow);
    }

    .source-truth-link-text {
      margin: 0;
      font-weight: 900;
    }

    .source-truth-link-icon {
      display: inline-grid;
      place-items: center;
      min-width: 44px;
      height: 44px;
      padding: 0 8px;
      border: 2px solid var(--pop-border);
      border-radius: 999px;
      background: var(--pop-orange);
      font-size: 0.76rem;
      font-weight: 900;
      text-transform: uppercase;
    }

    @media (max-width: 760px) {
      .shell {
        padding: 18px;
      }

      header {
        margin-bottom: 18px;
      }

      .split {
        grid-template-columns: 1fr;
      }

      .landing-hero,
      .split-section,
      .audience-section,
      .support-section {
        grid-template-columns: 1fr;
      }

      .landing-hero {
        gap: 26px;
        padding: 24px 0 38px;
      }

      .landing-hero-copy h2 {
        max-width: 11ch;
        font-size: clamp(2.7rem, 14vw, 4.4rem);
      }

      .landing-section {
        padding: 38px 0;
      }

      .problem-grid,
      .cadence-grid,
      .included-grid,
      .quote-grid,
      .example-grid {
        grid-template-columns: 1fr;
      }

      .example-panel.large {
        grid-column: span 1;
        min-height: 280px;
      }

      .button-row {
        flex-direction: column;
        align-items: stretch;
      }

      .button,
      .text-link {
        justify-content: center;
        text-align: center;
      }

      table,
      thead,
      tbody,
      th,
      td,
      tr {
        display: block;
      }

      thead {
        display: none;
      }

      td {
        padding: 8px 0;
      }

      td::before {
        content: attr(data-label);
        display: block;
        font-size: 0.78rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
      }

      .facepile li + li {
        margin-left: -8px;
      }

      .facepile-link {
        width: 44px;
        height: 44px;
      }

      body.event-landing .shell {
        padding: 16px;
      }

      body.event-landing nav a {
        flex: 1 1 auto;
        text-align: center;
      }

      .pop-hero,
      .section-head,
      .pie-share-overview,
      .rules-intro,
      .sponsor-layout,
      body.event-landing .split {
        grid-template-columns: 1fr;
      }

      .pop-panel,
      .source-truth-panel {
        padding: 20px;
        border-radius: 18px;
      }

      .pop-hero h2,
      .section-title,
      .sponsor-title,
      .source-truth-title {
        font-size: clamp(2.1rem, 13vw, 3.3rem);
      }

      .overview-grid,
      .rules-grid,
      .pie-share-grid,
      .kanban-board,
      .source-truth-links,
      .mini-grid {
        grid-template-columns: 1fr;
      }

      .priority-pill {
        max-width: none;
      }

      .pop-actions,
      .footer-actions {
        flex-direction: column;
        align-items: stretch;
      }
    }
  </style>
</head>
<body class="{{ layoutClass or '' }}">
  <div class="shell">
    <header>
      <h1><a href="{{ '/' | withBase }}" style="color: inherit; text-decoration: none;">Builder Season Playbook</a></h1>
      <p>A practical framework for long-form hackathons with weekly accountability, visible progress, and lightweight operations.</p>
      <nav>
        <a href="{{ '/' | withBase }}">Home</a>
        <a href="{{ '/#rules' | withBase }}">Rules</a>
        <a href="{{ '/#timeline' | withBase }}">Timeline</a>
        <a href="{{ '/#register' | withBase }}">Register</a>
        <a href="{{ '/dashboard/' | withBase }}">Current Season Dashboard</a>
        <a href="{{ '/use-this-model/' | withBase }}">Use This Model</a>
        {# <a href="{{ '/progress-log/' | withBase }}">Progress Log</a>
        <a href="{{ '/posts/' | withBase }}">Archive</a>
        <a href="{{ '/data/' | withBase }}">Data</a>
        <a href="{{ '/feed/feed.xml' | withBase }}">RSS Feed</a> #}
      </nav>
    </header>

    <main>
      {% block content %}{% endblock %}
    </main>

    <footer>
      <p>Built with <a href="https://www.11ty.dev/">Eleventy</a> · Last updated: {{ page.date | readableDate }}</p>
    </footer>
  </div>
</body>
</html>
