<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}Builder Season Playbook{% endblock %}</title>

  <meta property="og:image" content="{{ (og_image or '/images/og/11ty-blog-OG-default.jpg') | withBase }}">
  <meta property="og:title" content="{{ title or 'Builder Season Playbook' }}">
  <meta property="og:description" content="{{ description or 'Open web dashboard and progress log for Builder Season.' }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ page.url | withBase }}">

  <link rel="alternate" href="{{ '/feed/feed.xml' | withBase }}" type="application/atom+xml" title="Builder Season Playbook RSS Feed">

  <style>
    :root {
      --bg: #f7f5ef;
      --surface: #fffefa;
      --surface-quiet: #f0eee7;
      --text: #181715;
      --muted: #666158;
      --border: #d8d2c4;
      --border-strong: #b9b09f;
      --accent: #8f4b2d;
      --accent-dark: #5f301f;
      --card: #fffefa;
      --ink: #24211d;
      --code-bg: #ebe7dc;
    }

    * {
      box-sizing: border-box;
    }

    body {
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      line-height: 1.6;
      margin: 0;
      color: var(--text);
      background: linear-gradient(180deg, #fbfaf6 0%, var(--bg) 100%);
    }

    .shell {
      max-width: 1100px;
      margin: 0 auto;
      padding: 24px;
    }

    header {
      border-bottom: 1px solid var(--border);
      margin-bottom: 32px;
      padding-bottom: 18px;
    }

    header h1 {
      margin: 0;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(1.7rem, 3vw, 2.5rem);
      letter-spacing: 0;
    }

    header p {
      margin: 8px 0 0;
      color: var(--muted);
      max-width: 48rem;
      font-size: 0.98rem;
    }

    nav {
      margin-top: 16px;
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
    }

    nav a {
      color: var(--accent-dark);
      text-decoration: none;
      font-size: 0.92rem;
      font-weight: 700;
    }

    nav a:hover {
      text-decoration: underline;
    }

    main {
      min-height: 60vh;
    }

    footer {
      margin-top: 60px;
      padding-top: 20px;
      border-top: 1px solid var(--border);
      color: var(--muted);
      font-size: 0.9em;
    }

    a {
      color: var(--accent);
    }

    a:hover {
      color: var(--accent-dark);
    }

    pre {
      background: var(--code-bg);
      padding: 15px;
      overflow-x: auto;
      border-radius: 6px;
    }

    code {
      background: var(--code-bg);
      padding: 2px 6px;
      border-radius: 3px;
      font-size: 0.92em;
    }

    .card-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 18px;
    }

    .card,
    .table-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 18px;
      box-shadow: 0 8px 20px rgba(53, 39, 29, 0.04);
    }

    .card h2,
    .table-card h2,
    .table-card h3 {
      margin-top: 0;
    }

    .eyebrow {
      font-size: 0.78rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
      margin: 0 0 8px;
      font-weight: 800;
    }

    .stat {
      font-size: 2rem;
      font-weight: 700;
      margin: 0;
    }

    .button-row {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 24px;
    }

    .button {
      display: inline-block;
      background: var(--accent);
      color: #fffdf8;
      padding: 11px 16px;
      border-radius: 6px;
      text-decoration: none;
      font-weight: 700;
      border: 1px solid var(--accent);
      line-height: 1.2;
    }

    .button.secondary {
      background: transparent;
      color: var(--accent-dark);
      border: 1px solid var(--border);
    }

    .text-link {
      display: inline-flex;
      align-items: center;
      color: var(--accent-dark);
      font-weight: 800;
      text-decoration: none;
    }

    .text-link:hover {
      text-decoration: underline;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    th,
    td {
      text-align: left;
      padding: 12px 10px;
      border-bottom: 1px solid var(--border);
      vertical-align: top;
    }

    ul.clean {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    ul.clean li + li {
      margin-top: 12px;
    }

    .muted {
      color: var(--muted);
    }

    details summary {
      cursor: pointer;
      font-weight: 700;
      color: var(--accent-dark);
      list-style: none;
    }

    details summary::-webkit-details-marker {
      display: none;
    }

    details summary::before {
      content: "▸";
      display: inline-block;
      margin-right: 0.55rem;
      transition: transform 140ms ease;
    }

    details[open] summary::before {
      transform: rotate(90deg);
    }

    details > *:not(summary) {
      margin-top: 16px;
    }

    .hero {
      padding: 28px;
      background: linear-gradient(135deg, rgba(143, 75, 45, 0.10), rgba(255, 254, 250, 0.94));
      border: 1px solid var(--border);
      border-radius: 8px;
      margin-bottom: 28px;
    }

    .split {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 20px;
      align-items: start;
    }

    .facepile-section {
      display: grid;
      gap: 16px;
      align-items: center;
    }

    .facepile-copy {
      max-width: 42rem;
    }

    .facepile {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: 0;
      padding: 0;
      margin: 0;
    }

    .facepile li {
      margin: 0;
    }

    .facepile li + li {
      margin-left: -10px;
    }

    .facepile-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 48px;
      height: 48px;
      border-radius: 999px;
      border: 2px solid rgba(255, 253, 248, 0.95);
      background: #eadfcd;
      box-shadow: 0 8px 22px rgba(53, 39, 29, 0.12);
      overflow: hidden;
      transition: transform 140ms ease, box-shadow 140ms ease, border-color 140ms ease;
    }

    .facepile-link:hover,
    .facepile-link:focus-visible {
      transform: translateY(-2px);
      box-shadow: 0 12px 28px rgba(53, 39, 29, 0.18);
      border-color: rgba(164, 71, 34, 0.65);
      outline: none;
      position: relative;
      z-index: 1;
    }

    .facepile-avatar {
      display: block;
      width: 100%;
      height: 100%;
      border-radius: 999px;
      object-fit: cover;
      background: linear-gradient(135deg, #f4e7d3, #e1c8aa);
    }

    .facepile-caption {
      margin: 0;
      color: var(--muted);
    }

    .landing-hero,
    .landing-section {
      border-bottom: 1px solid var(--border);
    }

    .landing-hero {
      display: grid;
      grid-template-columns: minmax(0, 1.45fr) minmax(320px, 0.8fr);
      gap: 40px;
      align-items: center;
      padding: 44px 0 54px;
    }

    .landing-hero-copy h2,
    .landing-section h2 {
      font-family: Georgia, "Times New Roman", serif;
      letter-spacing: 0;
      line-height: 1.08;
      color: var(--ink);
    }

    .landing-hero-copy h2 {
      max-width: 13ch;
      margin: 0;
      font-size: clamp(3rem, 7vw, 6.5rem);
    }

    .lede {
      max-width: 43rem;
      margin: 22px 0 0;
      color: var(--muted);
      font-size: clamp(1.08rem, 2vw, 1.28rem);
    }

    .workflow-panel,
    .example-panel {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      box-shadow: 0 18px 44px rgba(45, 39, 30, 0.08);
    }

    .workflow-panel {
      padding: 18px;
    }

    .panel-header {
      display: flex;
      justify-content: space-between;
      gap: 14px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--border);
      color: var(--muted);
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
      font-size: 0.78rem;
    }

    .status-row {
      display: grid;
      grid-template-columns: 76px 1fr;
      gap: 14px;
      align-items: baseline;
      padding: 16px 0;
      border-bottom: 1px solid var(--border);
    }

    .status-row strong {
      font-family: Georgia, "Times New Roman", serif;
      font-size: 2rem;
      line-height: 1;
    }

    .status-row span {
      color: var(--muted);
    }

    .workflow-list {
      margin: 18px 0 0;
      padding-left: 22px;
    }

    .workflow-list li + li {
      margin-top: 8px;
    }

    .landing-section {
      padding: 54px 0;
    }

    .split-section,
    .audience-section,
    .support-section {
      display: grid;
      grid-template-columns: minmax(220px, 0.65fr) minmax(0, 1fr);
      gap: 34px;
      align-items: start;
    }

    .landing-section h2 {
      margin: 0;
      font-size: clamp(2rem, 4vw, 3.75rem);
    }

    .landing-section h3 {
      margin: 0 0 8px;
      font-size: 1rem;
    }

    .landing-section p {
      color: var(--muted);
    }

    .section-heading {
      max-width: 48rem;
      margin-bottom: 28px;
    }

    .section-heading p:not(.eyebrow) {
      font-size: 1.05rem;
    }

    .problem-grid,
    .cadence-grid,
    .included-grid,
    .quote-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .problem-grid article,
    .cadence-grid article,
    .included-grid > div {
      padding: 18px;
      background: rgba(255, 254, 250, 0.72);
      border: 1px solid var(--border);
      border-radius: 8px;
    }

    .problem-grid p,
    .cadence-grid p {
      margin: 0;
    }

    .step-number,
    .panel-kicker {
      display: block;
      margin-bottom: 10px;
      color: var(--muted);
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
      font-size: 0.78rem;
      font-weight: 800;
      text-transform: uppercase;
    }

    .check-list {
      margin: 0;
      padding-left: 20px;
      color: var(--muted);
    }

    .check-list li + li {
      margin-top: 8px;
    }

    .example-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
    }

    .example-panel {
      min-height: 180px;
      padding: 18px;
      color: inherit;
      text-decoration: none;
    }

    .example-panel.large {
      grid-column: span 2;
      min-height: 320px;
      background:
        linear-gradient(180deg, rgba(255, 254, 250, 0.92), rgba(240, 238, 231, 0.76)),
        repeating-linear-gradient(0deg, transparent 0, transparent 35px, rgba(216, 210, 196, 0.45) 36px);
    }

    .example-panel:hover {
      border-color: var(--border-strong);
    }

    .example-panel strong {
      display: block;
      max-width: 28rem;
      font-size: 1.08rem;
      line-height: 1.35;
    }

    .mini-table {
      display: grid;
      grid-template-columns: 1fr 1fr 80px;
      margin-top: 28px;
      border: 1px solid var(--border);
      border-radius: 6px;
      overflow: hidden;
      color: var(--muted);
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
      font-size: 0.78rem;
    }

    .mini-table span {
      padding: 10px;
      border-right: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      background: rgba(255, 254, 250, 0.66);
    }

    .mini-table span:nth-child(3n) {
      border-right: 0;
    }

    .mini-table span:nth-last-child(-n + 3) {
      border-bottom: 0;
    }

    .tag-list {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .tag-list li {
      padding: 8px 11px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 999px;
      color: var(--ink);
      font-size: 0.92rem;
      font-weight: 700;
    }

    .quote-grid blockquote {
      margin: 0;
      padding: 22px;
      background: var(--ink);
      border-radius: 8px;
      color: #fffefa;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(1.35rem, 3vw, 2.2rem);
      line-height: 1.15;
    }

    .support-section {
      border-bottom: 0;
    }

    .support-section p {
      max-width: 46rem;
      font-size: 1.05rem;
    }

    .support-actions {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      padding: 18px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
    }

    @media (max-width: 760px) {
      .shell {
        padding: 18px;
      }

      header {
        margin-bottom: 18px;
      }

      .split {
        grid-template-columns: 1fr;
      }

      .landing-hero,
      .split-section,
      .audience-section,
      .support-section {
        grid-template-columns: 1fr;
      }

      .landing-hero {
        gap: 26px;
        padding: 24px 0 38px;
      }

      .landing-hero-copy h2 {
        max-width: 11ch;
        font-size: clamp(2.7rem, 14vw, 4.4rem);
      }

      .landing-section {
        padding: 38px 0;
      }

      .problem-grid,
      .cadence-grid,
      .included-grid,
      .quote-grid,
      .example-grid {
        grid-template-columns: 1fr;
      }

      .example-panel.large {
        grid-column: span 1;
        min-height: 280px;
      }

      .button-row {
        flex-direction: column;
        align-items: stretch;
      }

      .button,
      .text-link {
        justify-content: center;
        text-align: center;
      }

      table,
      thead,
      tbody,
      th,
      td,
      tr {
        display: block;
      }

      thead {
        display: none;
      }

      td {
        padding: 8px 0;
      }

      td::before {
        content: attr(data-label);
        display: block;
        font-size: 0.78rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
      }

      .facepile li + li {
        margin-left: -8px;
      }

      .facepile-link {
        width: 44px;
        height: 44px;
      }
    }
  </style>
</head>
<body>
  <div class="shell">
    <header>
      <h1><a href="{{ '/' | withBase }}" style="color: inherit; text-decoration: none;">Builder Season Playbook</a></h1>
      <p>A practical framework for long-form hackathons with weekly accountability, visible progress, and lightweight operations.</p>
      <nav>
        <a href="{{ '/' | withBase }}">Home</a>
        <a href="{{ '/dashboard/' | withBase }}">Current Season Dashboard</a>
        {# <a href="{{ '/progress-log/' | withBase }}">Progress Log</a>
        <a href="{{ '/posts/' | withBase }}">Archive</a>
        <a href="{{ '/data/' | withBase }}">Data</a>
        <a href="{{ '/feed/feed.xml' | withBase }}">RSS Feed</a> #}
      </nav>
    </header>

    <main>
      {% block content %}{% endblock %}
    </main>

    <footer>
      <p>Built with <a href="https://www.11ty.dev/">Eleventy</a> · Last updated: {{ page.date | readableDate }}</p>
    </footer>
  </div>
</body>
</html>
